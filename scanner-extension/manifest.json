{
  "manifest_version": 3,
  "key": "",
  "name": "Project Pepsi Marketplace Scanner",
  "version": "0.4.0",
  "description": "Read-only, supervised discovery for Facebook Marketplace watch listings.",
  "permissions": ["alarms", "notifications", "scripting", "storage", "tabs"],
  "host_permissions": ["https://www.facebook.com/marketplace/*", "https://*.fbcdn.net/*", "https://project-pepsi-trade-intelligence.patrickfoley2017.chatgpt.site/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Project Pepsi Scanner", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["https://www.facebook.com/marketplace/*"],
    "js": ["locations.js", "content.js"],
    "run_at": "document_idle"
  }]
}
